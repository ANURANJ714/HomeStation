<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/user/home.css">
    <link rel="stylesheet" href="/css/user/topdeals.css">
</head>

<body>
    <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <%- include('../partials/user/promoBar') %>

    <%- include('../partials/user/header', { activePage: 'bestsellers' }) %>

    <main class="bestseller-page">
        <div class="container bestseller-container">
            <section class="main-content">
                <div class="page-header">
                    <h2>Top Deals</h2>
                    <div class="header-filters">
                        <label for="priceFilter">Filter by Price:</label>
                        <select id="priceFilter" class="filter-dropdown">
                            <option value="all" <%= currentPriceSort === 'all' ? 'selected' : '' %>>All Price Range</option>
                            <option value="low-to-high" <%= currentPriceSort === 'low-to-high' ? 'selected' : '' %>>Low to High</option>
                            <option value="high-to-low" <%= currentPriceSort === 'high-to-low' ? 'selected' : '' %>>High to Low</option>
                        </select>
                    </div>
                </div>

                <div class="products-grid">
                    <% if (typeof variants !== 'undefined' && variants.length > 0) { %>
                        <% variants.forEach(v => { %>
                            <% 
                                const prodIdStr = (v.productId._id || v.productId).toString();
                                const pReview = (typeof productRatingsMap !== 'undefined' && productRatingsMap[prodIdStr]) ? productRatingsMap[prodIdStr] : null;
                            %>
                            <div class="product-card clickable-product-card" data-product-id="<%= prodIdStr %>">
                                <div class="product-image">
                                    <img src="<%= (v.productId.images && v.productId.images.length > 0) ? v.productId.images[0] : 'https://placehold.co/400' %>" alt="<%= v.productId.name %>">
                                    <span class="badge discount">-<%= v.discount %>%</span>
                                    <% 
                                        const variantIdStr = v._id.toString(); 
                                        const isLiked = typeof userWishlist !== 'undefined' && userWishlist.includes(variantIdStr); 
                                    %>
                                    <button class="wishlist-btn <%= isLiked ? 'liked' : '' %>" type="button" data-variant-id="<%= variantIdStr %>">
                                        <i class="<%= isLiked ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                                    </button>
                                </div>
                                <div class="product-info">
                                    <h3><%= v.productId.name %> (<%= v.variantName %>)</h3>
                                    <div class="stars">
                                        <% if (pReview && pReview.count > 0) { %>
                                            <% for (let rStar = 1; rStar <= 5; rStar++) { %>
                                                <% if (pReview.avgRating >= rStar) { %>
                                                    <i class="fa-solid fa-star active-star"></i>
                                                <% } else if (pReview.avgRating >= rStar - 0.5) { %>
                                                    <i class="fa-solid fa-star-half-stroke active-star"></i>
                                                <% } else { %>
                                                    <i class="fa-regular fa-star empty-star"></i>
                                                <% } %>
                                            <% } %>
                                            <span class="card-review-stat"><%= pReview.avgRating %> (<%= pReview.count %>)</span>
                                        <% } else { %>
                                            <span class="no-card-reviews">No reviews yet</span>
                                        <% } %>
                                    </div>
                                    <div class="card-footer">
                                        <div class="price-wrapper">
                                            <% if (v.discount > 0) { %>
                                                <span class="old-price">₹<%= v.originalPrice.toLocaleString('en-IN') %></span>
                                            <% } %>
                                            <p class="price">₹<%= v.calculatedPrice.toLocaleString('en-IN') %></p>
                                        </div>
                                        <button class="add-to-cart-btn" type="button" data-variant-id="<%= variantIdStr %>">
                                            <i class="fa-solid fa-cart-plus"></i> Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="no-deals-fallback-notice">
                            <p>No active promotional discount deals are running currently. Please check back later!</p>
                        </div>
                    <% } %>
                </div>

                <% if (totalPages > 1) { %>
                    <div class="pagination">
                        <% if (currentPage > 1) { %>
                            <button class="page-btn change-deals-page-btn" type="button" data-page="<%= currentPage - 1 %>">
                                <i class="fa-solid fa-chevron-left"></i> Previous
                            </button>
                        <% } else { %>
                            <button class="page-btn disabled" type="button" disabled>
                                <i class="fa-solid fa-chevron-left"></i> Previous
                            </button>
                        <% } %>

                        <div class="page-numbers">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <button class="page-num change-deals-page-btn <%= i === currentPage ? 'active' : '' %>" type="button" data-page="<%= i %>">
                                    <%= i %>
                                </button>
                            <% } %>
                        </div>

                        <% if (currentPage < totalPages) { %>
                            <button class="page-btn change-deals-page-btn" type="button" data-page="<%= currentPage + 1 %>">
                                Next <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        <% } else { %>
                            <button class="page-btn disabled" type="button" disabled>
                                Next <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        <% } %>
                    </div>
                <% } %>
            </section>
        </div>
    </main>

    <%- include('../partials/user/footer') %>

    <script src="/js/user/topdeals.js"></script>
</body>

</html>