<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="/css/user/home.css">
    <link rel="stylesheet" href="/css/user/verify-email.css">
</head>

<body class="shared-bg">
    <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <%- include('../partials/user/promoBar') %>

    <%- include('../partials/user/header', { activePage: '' }) %>

    <section class="profile-section">
        <div class="container profile-layout">

            <aside class="profile-sidebar" id="appSidebar">
                <div class="profile-user-info">
                    <img src="<%= (user && user.profileImage) ? user.profileImage : 'https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png' %>"
                        alt="Profile" class="sidebar-avatar">
                    <div class="user-greeting">
                        <span class="hello-text">Hello,</span>
                        <span class="user-name" id="sidebarName">
                            <%= (user && user.fullName) ? user.fullName : 'User' %>
                        </span>
                    </div>
                </div>

                <hr class="sidebar-divider">
                <div class="sidebar-menu">
                    <h3>Account Settings</h3>
                    <ul>
                        <li><a href="/user/profile" class="active">Profile information</a></li>
                        <li><a href="/user/addresses">Manage addresses</a></li>
                    </ul>
                    <hr class="sidebar-divider">
                    <h3>My Stuffs</h3>
                    <ul>
                        <li><a href="/user/orders">My Orders</a></li>
                        <li><a href="/user/wishlist">My Wishlists</a></li>
                        <li><a href="/user/wallet">My Wallet</a></li>
                        <li><a href="/user/coupons">Coupons Available</a></li>
                    </ul>
                    <hr class="sidebar-divider">

                    <div class="logout-wrapper">
                        <form action="/user/logout" method="POST" id="logoutForm" class="m-0">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <button type="submit" class="logout-link">
                                <i class="fa-solid fa-power-off"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <main class="profile-content">
                <div class="view-header-row">
                    <h2 class="edit-profile-title m-0">Verify New Email</h2>
                </div>

                <div class="profile-info-section pb-30">
                    <p class="verification-notice-text">
                        Please enter the 6-digit OTP sent to <strong><%= newEmail %></strong> to confirm your email change.
                    </p>

                    <div class="profile-form">
                        <form id="emailOtpForm" novalidate>
                            <div class="form-group">
                                <label class="mb-10">Enter 6-Digit OTP</label>
                                <div class="otp-container">
                                    <input type="text" class="form-control otp-input" maxlength="1" inputmode="numeric" autofocus>
                                    <input type="text" class="form-control otp-input" maxlength="1" inputmode="numeric">
                                    <input type="text" class="form-control otp-input" maxlength="1" inputmode="numeric">
                                    <input type="text" class="form-control otp-input" maxlength="1" inputmode="numeric">
                                    <input type="text" class="form-control otp-input" maxlength="1" inputmode="numeric">
                                    <input type="text" class="form-control otp-input" maxlength="1" inputmode="numeric">
                                </div>
                            </div>

                            <div class="resend-container-wrapper">
                                <span class="resend-notice-label">Didn't receive the code? </span>
                                <a href="#" id="resendOtpBtn" class="link-red resend-btn-link">Resend OTP</a>
                            </div>

                            <div class="password-actions">
                                <a href="/user/profile" class="btn-cancel-gray text-decoration-none d-inline-block">Cancel</a>
                                <button type="submit" class="btn-save btn-submit-padding">Verify OTP</button>
                            </div>
                        </form>
                    </div>
                </div>
            </main>

        </div>
    </section>

    <%- include('../partials/user/footer') %>

    <script src="/js/user/verify-email.js"></script>
</body>

</html>