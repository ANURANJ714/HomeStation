<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation - Order Details</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="/css/user/orderdetail.css">
</head>

<body>
    <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <input type="hidden" id="currentOrderId" value="<%= order.orderId %>">

    <% if (typeof bannerText !== 'undefined' && bannerText) { %>
        <div class="promo-bar">
            <b><%- bannerText %></b>
        </div>
    <% } %>

    <header class="header">
        <div class="container-fluid header-container">
            <a href="/home" class="logo">HomeStation</a>
            <nav class="nav">
                <ul class="nav-list">
                    <li><a href="/home" class="nav-link">Home</a></li>
                    <li><a href="/products" class="nav-link">World of Mattress</a></li>
                    <li><a href="/deals" class="nav-link">Top Deals</a></li>
                    <li><a href="/bestsellers" class="nav-link">Best Sellers</a></li>
                    <li><a href="/contact" class="nav-link">Contact Us</a></li>
                </ul>
            </nav>
            <div class="search-container">
                <input type="text" placeholder="Search for products..." id="searchInput">
                <button id="searchBtn" type="button"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
            <div class="header-actions">
                <a href="/user/wishlist" class="icon-link wishlist-link"><i class="fa-regular fa-heart"></i> Wishlist</a>
                <a href="/user/profile" class="icon-link"><i class="fa-solid fa-user"></i> Profile</a>
                <a href="/user/cart" class="icon-link"><i class="fa-solid fa-cart-shopping"></i> Cart</a>
            </div>
        </div>
    </header>

    <div class="container breadcrumb-section">
        <a href="/user/orders" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Orders</a>
    </div>

    <section class="order-detail-wrapper">
        <div class="container">
            <div class="order-detail-box">
                <% if (overallReturnStatus && overallReturnStatus !== 'none') { %>
                    <div class="status-tracker-container return-tracker-bg">
                        <div class="status-tracker-bar">
                            <% 
                                const rSteps = [
                                    { label: 'Return Initiated', key: 'return initiated', icon: 'fa-rotate-left' },
                                    { label: 'Pickup Assigned', key: 'pickup assigned', icon: 'fa-user-check' },
                                    { label: 'Item Picked Up', key: 'item picked up', icon: 'fa-box' },
                                    { label: 'In Transit', key: 'in transit', icon: 'fa-truck-fast' },
                                    { label: 'Item Reached', key: 'item reached', icon: 'fa-warehouse' }
                                ];
                            %>
                            <% rSteps.forEach((step, idx) => { 
                                const isCompleted = idx <= currentReturnStepIndex;
                                const isActive = idx === currentReturnStepIndex;
                            %>
                                <div class="tracker-step return-step <%= isCompleted ? 'completed-return' : '' %> <%= isActive ? 'active-return' : '' %>">
                                    <div class="tracker-node">
                                        <i class="fa-solid <%= step.icon %>"></i>
                                    </div>
                                    <span class="tracker-label"><%= step.label %></span>
                                </div>
                                <% if (idx < rSteps.length - 1) { %>
                                    <div class="tracker-line <%= idx < currentReturnStepIndex ? 'completed-return-line' : '' %>"></div>
                                <% } %>
                            <% }) %>
                        </div>
                    </div>
                <% } else if (overallStatus !== 'cancelled') { %>
                    <div class="status-tracker-container">
                        <div class="status-tracker-bar">
                            <% 
                                const steps = [
                                    { label: 'Processing', key: 'processing', icon: 'fa-clock' },
                                    { label: 'Packed', key: 'packed', icon: 'fa-box' },
                                    { label: 'Shipped', key: 'shipped', icon: 'fa-truck' },
                                    { label: 'On The Way', key: 'on the way', icon: 'fa-truck-fast' },
                                    { label: 'Out for Delivery', key: 'out for delivery', icon: 'fa-person-biking' },
                                    { label: 'Delivered', key: 'delivered', icon: 'fa-box-open' }
                                ];
                            %>
                            <% steps.forEach((step, idx) => { 
                                const isCompleted = idx <= currentStepIndex;
                                const isActive = idx === currentStepIndex;
                            %>
                                <div class="tracker-step <%= isCompleted ? 'completed' : '' %> <%= isActive ? 'active' : '' %>">
                                    <div class="tracker-node">
                                        <i class="fa-solid <%= step.icon %>"></i>
                                    </div>
                                    <span class="tracker-label"><%= step.label %></span>
                                </div>
                                <% if (idx < steps.length - 1) { %>
                                    <div class="tracker-line <%= idx < currentStepIndex ? 'completed-line' : '' %>"></div>
                                <% } %>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <div class="detail-content">
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Order ID</span>
                            <span class="detail-value"><%= order.orderId %></span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Order Date</span>
                            <span class="detail-value"><%= formattedOrderDate %></span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">
                                <%= overallStatus === 'delivered' ? 'Delivered Date' : (overallStatus === 'cancelled' ? 'Cancelled Date' : 'Expected Date') %>
                            </span>
                            <span class="detail-value">
                                <%= (overallStatus === 'delivered' || overallStatus === 'cancelled') ? formattedUpdatedDate : formattedExpectedDate %>
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Payment Mode</span>
                            <span class="detail-value"><%= paymentModeLabel %> · <%= paymentStatusText %></span>
                        </div>

                        <% if (order.orderItems && order.orderItems.length > 0) { %>
                            <% order.orderItems.forEach(item => { 
                                const variant = item.productVariantId;
                                const product = variant?.productId;
                                const categoryName = product?.categoryId?.name || 'Sleep Essentials';
                                const firstImage = (product?.images && product.images.length > 0) ? product.images[0] : 'https://placehold.co/280x160';
                                const productId = product?._id ? product._id.toString() : '';
                                const existingReview = (typeof userReviews !== 'undefined' && userReviews && userReviews[productId]) ? userReviews[productId] : null;
                                const hasReturn = item.returnStatus && item.returnStatus !== 'none';
                            %>
                                <div class="detail-item full-width product-main-info">
                                    <div class="product-text-details">
                                        <div class="info-group">
                                            <span class="detail-label">Product Name</span>
                                            <span class="detail-value product-name-large">
                                                <%= product?.name || 'Product Name Unavailable' %> (<%= variant?.variantName || 'Standard' %>)
                                            </span>
                                        </div>

                                        <div class="info-group">
                                            <span class="detail-label">Item Status</span>
                                            <div class="item-status-prominent">
                                                <% if (hasReturn) { %>
                                                    <span class="badge-status-prominent badge-orange">
                                                        <i class="fa-solid fa-rotate-left"></i> <%= item.returnStatus.charAt(0).toUpperCase() + item.returnStatus.slice(1) %>
                                                    </span>
                                                <% } else if (item.itemStatus === 'delivered' && item.returnStatus === 'none') { %>
                                                    <span class="badge-status-prominent badge-success">
                                                        <i class="fa-solid fa-circle-check"></i> Delivered
                                                    </span>
                                                    <% if (isReturnEligible) { %>
                                                        <span class="item-return-window-note"><i class="fa-solid fa-clock-rotate-left"></i> Return eligible until <%= formattedReturnDeadline %></span>
                                                    <% } %>
                                                <% } else if (item.itemStatus === 'cancelled' && item.returnStatus === 'none') { %>
                                                    <span class="badge-status-prominent badge-danger">
                                                        <i class="fa-solid fa-circle-xmark"></i> Cancelled
                                                    </span>
                                                <% } else if (item.itemStatus === 'packed' && item.returnStatus === 'none') { %>
                                                    <span class="badge-status-prominent badge-warning">
                                                        <i class="fa-solid fa-box"></i> Packed
                                                    </span>
                                                <% } else if (item.itemStatus === 'shipped' && item.returnStatus === 'none') { %>
                                                    <span class="badge-status-prominent badge-info">
                                                        <i class="fa-solid fa-truck"></i> Shipped
                                                    </span>
                                                <% } else if (item.itemStatus === 'on the way' && item.returnStatus === 'none') { %>
                                                    <span class="badge-status-prominent badge-info">
                                                        <i class="fa-solid fa-truck-fast"></i> On the Way
                                                    </span>
                                                <% } else if (item.itemStatus === 'out for delivery' && item.returnStatus === 'none') { %>
                                                    <span class="badge-status-prominent badge-warning">
                                                        <i class="fa-solid fa-person-biking"></i> Out for Delivery
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge-status-prominent badge-info">
                                                        <i class="fa-solid fa-clock"></i> Processing
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="info-group">
                                            <span class="detail-label">Category</span>
                                            <span class="detail-value"><%= categoryName %></span>
                                        </div>
                                        <div class="info-group">
                                            <span class="detail-label">Price & Quantity</span>
                                            <span class="detail-value">₹<%= item.currentPrice.toLocaleString('en-IN') %> × <%= item.quantity %> = <strong>₹<%= (item.currentPrice * item.quantity).toLocaleString('en-IN') %></strong></span>
                                        </div>

                                        <div class="item-actions-row">
                                            <% if (item.itemStatus === 'delivered' && item.returnStatus === 'none') { %>
                                                <button type="button" class="btn-modal-action btn-review trigger-review-modal-btn"
                                                    data-product-id="<%= productId %>"
                                                    data-product-name="<%= product?.name || 'Product' %>"
                                                    data-existing-rating="<%= existingReview ? existingReview.rating : 5 %>"
                                                    data-existing-comment="<%= existingReview ? existingReview.comment : '' %>">
                                                    <% if (existingReview) { %>
                                                        <i class="fa-solid fa-pen-to-square"></i> Edit Review
                                                    <% } else { %>
                                                        <i class="fa-solid fa-star"></i> Write a Review
                                                    <% } %>
                                                </button>

                                                <% if (isReturnEligible) { %>
                                                    <button type="button" class="btn-modal-action btn-return trigger-item-return-btn" data-item-id="<%= item._id %>">
                                                        <i class="fa-solid fa-rotate-left"></i> Return Item
                                                    </button>
                                                <% } %>
                                            <% } else if (item.itemStatus !== 'cancelled' && (!item.returnStatus || item.returnStatus === 'none')) { %>
                                                <button type="button" class="btn-modal-action btn-cancel trigger-item-cancel-btn" data-item-id="<%= item._id %>">
                                                    <i class="fa-solid fa-ban"></i> Cancel Item
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="product-image-box">
                                        <a href="/products/<%= productId %>" title="View Product Details">
                                            <img src="<%= firstImage %>" alt="<%= product?.name || 'Product Image' %>" class="product-hero-img">
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>

                        <div class="detail-item full-width">
                            <span class="detail-label">Delivery Address</span>
                            <div class="detail-value address-block">
                                <p class="address-name"><%= order.shippingAddress.name %></p>
                                <p class="address-line"><%= order.shippingAddress.fullAddress %></p>
                                <p class="address-line"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
                                <p class="address-phone"><i class="fa-solid fa-phone"></i> <%= order.shippingAddress.phone %></p>
                            </div>
                        </div>
                    </div>

                    <div class="action-buttons-row">
                        <% if (overallReturnStatus !== 'none') { %>
                        <% } else { %>
                            <% if (overallStatus === 'delivered') { %>
                                <% if (isReturnEligible && hasReturnableItems) { %>
                                    <button type="button" class="btn-modal-action btn-return" id="openFullOrderReturnBtn">
                                        <i class="fa-solid fa-rotate-left"></i> Return Entire Order
                                    </button>
                                <% } %>
                                <% const cleanOrderId = order.orderId ? order.orderId.replace(/^#/, '') : ''; %>
                                <a href="/user/orders/invoice/<%= cleanOrderId %>" class="btn-modal-action btn-invoice">
                                    <i class="fa-solid fa-file-invoice"></i> Download Invoice
                                </a>
                            <% } else if (overallStatus !== 'cancelled' && hasCancellableItems) { %>
                                <button type="button" class="btn-modal-action btn-cancel" id="openFullOrderCancelBtn">
                                    <i class="fa-solid fa-ban"></i> Cancel Entire Order
                                </button>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="modal-overlay" id="reviewModal">
        <div class="modal-box modal-box-sm">
            <div class="modal-header">
                <h3 class="modal-title" id="reviewModalTitle"><i class="fa-solid fa-star"></i> Write a Review</h3>
                <button type="button" class="modal-close-btn" id="closeReviewModalBtn"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalReviewProductId" value="">
                <p id="reviewProductNameLabel">How was your experience with this product?</p>
                <div class="star-rating" id="starRating">
                    <i class="fa-solid fa-star rating-star active" data-rating="1"></i>
                    <i class="fa-solid fa-star rating-star active" data-rating="2"></i>
                    <i class="fa-solid fa-star rating-star active" data-rating="3"></i>
                    <i class="fa-solid fa-star rating-star active" data-rating="4"></i>
                    <i class="fa-solid fa-star rating-star active" data-rating="5"></i>
                </div>
                <textarea class="review-textarea" id="reviewText" placeholder="Write your review (minimum 10 characters)..."></textarea>
                <small class="field-error-msg" id="reviewErrorMsg"></small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-action btn-primary" id="submitReviewBtn">Submit Review</button>
                <button type="button" class="btn-modal-action btn-secondary" id="cancelReviewBtn">Cancel</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="returnModal">
        <div class="modal-box modal-box-sm">
            <div class="modal-header">
                <h3 class="modal-title" id="returnModalTitle"><i class="fa-solid fa-rotate-left"></i> Return Product</h3>
                <button type="button" class="modal-close-btn" id="closeReturnModalBtn"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalTargetReturnItemId" value="">
                <p class="modal-confirm-text">Please select a reason for returning:</p>
                <div class="reasons-list">
                    <label class="reason-option">
                        <input type="radio" name="returnReasonRadio" value="Product Damaged">
                        <span>Product Damaged</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="returnReasonRadio" value="Don't need this product anymore">
                        <span>Don't need this product anymore</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="returnReasonRadio" value="Item arrived too late">
                        <span>Item arrived too late</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="returnReasonRadio" value="Product does not match description">
                        <span>Product does not match description</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="returnReasonRadio" value="other">
                        <span>Other reason</span>
                    </label>
                </div>
                <textarea class="review-textarea custom-reason-textarea" id="customReturnReason" placeholder="Please specify your reason for returning..."></textarea>
            </div>
            <div class="modal-footer center-btns">
                <button type="button" class="btn-modal-action btn-danger" id="confirmReturnBtn">Confirm Return</button>
                <button type="button" class="btn-modal-action btn-secondary" id="cancelReturnBtn">Cancel</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="cancelOrderModal">
        <div class="modal-box modal-box-sm">
            <div class="modal-header">
                <h3 class="modal-title" id="cancelModalTitle"><i class="fa-solid fa-ban"></i> Cancel Product</h3>
                <button type="button" class="modal-close-btn" id="closeCancelOrderModalBtn"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalTargetCancelItemId" value="">
                <p class="modal-confirm-text">Please select or provide a reason for cancellation:</p>
                <div class="reasons-list">
                    <label class="reason-option">
                        <input type="radio" name="cancelReasonRadio" value="Ordered by mistake">
                        <span>Ordered by mistake</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="cancelReasonRadio" value="Found cheaper elsewhere">
                        <span>Found cheaper elsewhere</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="cancelReasonRadio" value="Delivery time is too long">
                        <span>Delivery time is too long</span>
                    </label>
                    <label class="reason-option">
                        <input type="radio" name="cancelReasonRadio" value="other">
                        <span>Other reason</span>
                    </label>
                </div>
                <textarea class="review-textarea custom-reason-textarea" id="customCancelReason" placeholder="Please specify your reason for cancelling..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-action btn-danger" id="submitCancelOrderBtn">Confirm Cancellation</button>
                <button type="button" class="btn-modal-action btn-secondary" id="cancelCancelOrderBtn">Keep Item</button>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container-fluid footer-container">
            <div class="footer-left">
                <a href="/home" class="logo footer-logo">HomeStation</a>
                <p>Your premier destination for high-quality mattresses and sleep essentials, crafted to bring cloud-like comfort to every night.</p>
            </div>
            <div class="footer-links-wrapper">
                <div class="footer-column">
                    <h4>Shop</h4>
                    <ul>
                        <li><a href="/products">World of Mattress</a></li>
                        <li><a href="/deals">Top Deals</a></li>
                        <li><a href="/bestsellers">Best Sellers</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h4>Support</h4>
                    <ul>
                        <li><a href="/user/orders">Track Your Orders</a></li>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/contact">Contact Us</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="container-fluid copyright">
            <p>&copy; 2026 HomeStation Store. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/user/orderdetail.js"></script>
</body>

</html>