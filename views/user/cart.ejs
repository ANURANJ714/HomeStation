<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="/css/user/home.css">
    <link rel="stylesheet" href="/css/user/cart.css">
</head>

<body>
    <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <% if (typeof unavailableNotice !== 'undefined' && unavailableNotice) { %>
        <input type="hidden" id="unavailableNoticePayload" value="<%= encodeURIComponent(JSON.stringify(unavailableNotice)) %>">
    <% } %>

    <% if (typeof stockExceededItem !== 'undefined' && stockExceededItem) { %>
        <input type="hidden" id="stockAlertItemId" value="<%= stockExceededItem.cartItemId %>">
        <input type="hidden" id="stockAlertAvailable" value="<%= stockExceededItem.availableStock %>">
        <input type="hidden" id="stockAlertName" value="<%= stockExceededItem.productName %>">
    <% } %>

    <%- include('../partials/user/promoBar') %>

    <%- include('../partials/user/header', { activePage: '' }) %>

    <main class="cart-main">
        <div class="container">
            <div class="checkout-steps">
                <div class="step active">1. Cart</div>
                <div class="step">2. Address</div>
                <div class="step">3. Payment</div>
                <div class="step">4. Order Review</div>
            </div>

            <h1 class="page-title">Shopping Cart (<%= totalQuantity %> Items)</h1>

            <div class="cart-content">
                <section class="cart-items-section">
                    <% if (cartItems && cartItems.length > 0) { %>
                        <% cartItems.forEach(item => {
                            const variant = item.productVariantId;
                            const product = variant.productId;
                            const discount = variant.effectiveDiscount || 0;
                            const currentPrice = variant.calculatedPrice;
                            const pIdStr = product._id.toString();
                            const pReview = (typeof productRatingsMap !== 'undefined' && productRatingsMap[pIdStr]) ? productRatingsMap[pIdStr] : null;
                        %>
                            <div class="cart-item clickable-cart-card" data-cart-id="<%= item._id %>" data-product-id="<%= product._id %>">
                                <div class="item-image">
                                    <img src="<%= (product.images && product.images[0]) ? product.images[0] : 'https://placehold.co/300' %>" alt="<%= product.name %>">
                                </div>
                                <div class="item-details">
                                    <div class="item-header">
                                        <h2 class="item-name"><%= product.name %> | Size : <%= variant.variantName %></h2>
                                        <button type="button" class="btn-remove trigger-delete-btn" data-cart-id="<%= item._id %>" title="Remove Item">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                    <div class="item-rating">
                                        <% if (pReview && pReview.count > 0) { %>
                                            <% for (let rStar = 1; rStar <= 5; rStar++) { %>
                                                <% if (pReview.avgRating >= rStar) { %>
                                                    <i class="fa-solid fa-star active-star"></i>
                                                <% } else if (pReview.avgRating >= rStar - 0.5) { %>
                                                    <i class="fa-solid fa-star-half-stroke active-star"></i>
                                                <% } else { %>
                                                    <i class="fa-regular fa-star empty-star"></i>
                                                <% } %>
                                            <% } %>
                                            <span class="card-review-stat"><%= pReview.avgRating %> (<%= pReview.count %> <%= pReview.count === 1 ? 'review' : 'reviews' %>)</span>
                                        <% } else { %>
                                            <span class="no-card-reviews">No reviews yet</span>
                                        <% } %>
                                    </div>
                                    <div class="item-actions">
                                        <div class="quantity-selector">
                                            <button type="button" class="qty-btn minus" data-cart-id="<%= item._id %>"><i class="fa-solid fa-minus"></i></button>
                                            <input type="text" value="<%= item.quantity %>" readonly>
                                            <button type="button" class="qty-btn plus" data-cart-id="<%= item._id %>"><i class="fa-solid fa-plus"></i></button>
                                        </div>
                                        <div class="item-price">
                                            <% if (discount > 0) { %>
                                                <span class="discount-badge"><%= discount %>% OFF</span>
                                                <span class="current-price">₹<%= currentPrice.toLocaleString('en-IN') %></span>
                                                <span class="original-price">₹<%= variant.originalPrice.toLocaleString('en-IN') %></span>
                                            <% } else { %>
                                                <span class="current-price">₹<%= currentPrice.toLocaleString('en-IN') %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-cart-message">
                            <p>Your cart is empty. Start exploring our mattresses!</p>
                            <a href="/products" class="btn-primary">Shop Now</a>
                        </div>
                    <% } %>
                </section>

                <section class="cart-summary-section">
                    <div class="summary-card">
                        <h2 class="summary-title">Order Summary</h2>
                        <div class="summary-details">
                            <div class="summary-row">
                                <span>Cart Subtotal (<%= totalQuantity %> items) <br><small>(Inclusive of 18% GST)</small></span>
                                <span>₹<%= subtotal.toLocaleString('en-IN') %></span>
                            </div>
                            <div class="summary-row">
                                <span>Offers</span>
                                <span class="discount-value">-₹0</span>
                            </div>
                            <div class="summary-row">
                                <span>Coupon applied</span>
                                <span class="discount-value">-₹0</span>
                            </div>
                            <div class="summary-row">
                                <span>Delivery Charges</span>
                                <span class="free-text">FREE</span>
                            </div>
                            <hr class="summary-divider">
                            <div class="summary-row total">
                                <span>Total Payable</span>
                                <span>₹<%= subtotal.toLocaleString('en-IN') %></span>
                            </div>
                        </div>
                        <div class="coupon-area">
                            <div class="coupon-header">
                                <p>Have a coupon?</p>
                                <a href="/user/coupons" class="check-coupons">Check available coupons</a>
                            </div>
                            <div class="coupon-input">
                                <input type="text" placeholder="Enter coupon code">
                                <button type="button" class="btn-apply">Apply</button>
                            </div>
                        </div>
                        <% if (cartItems && cartItems.length > 0) { %>
                            <button type="button" class="btn-checkout checkout-link-block" id="proceedCheckoutBtn">
                                Proceed to Checkout
                            </button>
                        <% } else { %>
                            <button type="button" class="btn-checkout checkout-disabled-btn" disabled>
                                Proceed to Checkout
                            </button>
                        <% } %>
                        <p class="secure-checkout"><i class="fa-solid fa-lock"></i> 100% Secure Checkout</p>
                        <img class="rzp-logo" src="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1787248893/Stripe__company_-Powered-by-Stripe-Logo.wine_hcrsue.png" alt="Stripe Logo">
                    </div>
                </section>
            </div>
        </div>
    </main>

    <%- include('../partials/user/footer') %>

    <div id="deleteModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-icon">
                <i class="fa-solid fa-circle-question"></i>
            </div>
            <h3>Confirm Removal</h3>
            <p>Are you sure want to remove this item from cart?</p>
            <div class="modal-actions">
                <button type="button" class="btn-modal-back" id="closeModal">Back</button>
                <button type="button" class="btn-modal-delete" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>

    <script src="/js/user/cart.js"></script>
</body>

</html>