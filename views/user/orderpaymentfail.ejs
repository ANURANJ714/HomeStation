<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation - Payment Failed</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="/css/user/orderpaymentfail.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>

<body>
    <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <main class="failure-wrapper">
        <div class="failure-card">
            <div class="brand">HomeStation</div>
            <div class="failure-icon">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <h1 class="failure-title">Payment Failed!</h1>
            <p class="failure-text">Unfortunately, we couldn't process your payment. You can retry the payment directly or return to Home.</p>
            
            <div class="action-area">
                <button type="button" class="btn-retry" id="btnRetryPayment">
                    <i class="fa-solid fa-rotate-right"></i> Retry Payment
                </button>
                <a href="/home" class="btn-home">Back to Home</a>
            </div>
        </div>
    </main>

    <script src="/js/user/orderresult.js"></script>
</body>

</html>