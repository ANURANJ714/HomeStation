<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="/css/user/home.css">
</head>

<body>
    <input type="hidden" id="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <input type="hidden" id="cartJustAdded" value="<%= typeof cartJustAdded !== 'undefined' ? cartJustAdded : false %>">
    <input type="hidden" id="wishlistJustAdded" value="<%= typeof wishlistJustAdded !== 'undefined' ? wishlistJustAdded : false %>">

    <%- include('../partials/user/promoBar') %>

    <%- include('../partials/user/header', { activePage: 'home' }) %>

    <section class="hero-section">
        <img src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&q=80&w=1200" alt="Premium Mattress" class="hero-bg-image">
        <div class="hero-content">
            <h1 class="hero-title">Experience Cloud Like Comfort</h1>
            <p class="hero-desc">Discover our range of premium mattresses designed for the perfect night's sleep.</p>
            <a href="/products" class="btn-primary hero-btn-link">Shop Mattress</a>
        </div>
    </section>

    <section class="products-section">
        <div class="container">
            <div class="section-header">
                <h2>Best Sellers</h2>
                <a href="/bestsellers" class="see-all">See All <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="products-grid">
                <% if (typeof bestSellers !== 'undefined' && bestSellers && bestSellers.length > 0) { %>
                    <% bestSellers.forEach(product => {
                        const variant = product.firstVariant;
                        const pReview = (typeof productRatingsMap !== 'undefined' && productRatingsMap[product._id.toString()]) ? productRatingsMap[product._id.toString()] : null;
                        if(variant) {
                            const discount = variant.effectiveDiscount || 0;
                            const currentPrice = variant.calculatedCurrentPrice;
                    %>
                        <div class="product-card clickable-product-card" data-product-id="<%= product._id %>">
                            <div class="product-image">
                                <img src="<%= product.images && product.images[0] ? product.images[0] : 'https://placehold.co/400' %>" alt="<%= product.name %>">
                                <div class="badge-container">
                                    <% if (discount > 0) { %>
                                        <span class="badge discount">
                                            <%= discount %>% OFF
                                        </span>
                                    <% } %>
                                </div>
                                <% 
                                    const variantIdStr = variant._id.toString(); 
                                    const isInWishlist = typeof userWishlist !== 'undefined' && userWishlist.includes(variantIdStr); 
                                %>
                                <button class="wishlist-btn <%= isInWishlist ? 'liked' : '' %>" type="button" data-variant-id="<%= variant._id %>">
                                    <i class="<%= isInWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                                </button>
                            </div>
                            <div class="product-info">
                                <h3><%= product.name %></h3>
                                <div class="stars">
                                    <% if (pReview && pReview.count > 0) { %>
                                        <% for (let rStar = 1; rStar <= 5; rStar++) { %>
                                            <% if (pReview.avgRating >= rStar) { %>
                                                <i class="fa-solid fa-star active-star"></i>
                                            <% } else if (pReview.avgRating >= rStar - 0.5) { %>
                                                <i class="fa-solid fa-star-half-stroke active-star"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-star empty-star"></i>
                                            <% } %>
                                        <% } %>
                                        <span class="card-review-stat"><%= pReview.avgRating %> (<%= pReview.count %>)</span>
                                    <% } else { %>
                                        <span class="no-card-reviews">No reviews yet</span>
                                    <% } %>
                                </div>
                                <div class="card-footer">
                                    <p class="price">
                                        <% if (discount > 0) { %>
                                            <span class="old-price">₹<%= variant.originalPrice.toLocaleString('en-IN') %></span>
                                        <% } %>
                                        ₹<%= currentPrice.toLocaleString('en-IN') %>
                                    </p>
                                    <button class="add-to-cart-btn" type="button" data-variant-id="<%= variant._id %>">
                                        <i class="fa-solid fa-cart-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    <% }); %>
                <% } else { %>
                    <p class="fallback-notice-text">More amazing products coming soon!</p>
                <% } %>
            </div>
        </div>
    </section>

    <section class="products-section deals-section">
        <div class="container">
            <div class="section-header">
                <h2>Top Deals</h2>
                <a href="/deals" class="see-all">See All <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="products-grid">
                <% if (typeof topDeals !== 'undefined' && topDeals && topDeals.length > 0) { %>
                    <% topDeals.forEach(deal => {
                        const product = deal.product;
                        const variant = deal.variant;
                        if(product && variant) {
                            const pReview = (typeof productRatingsMap !== 'undefined' && productRatingsMap[product._id.toString()]) ? productRatingsMap[product._id.toString()] : null;
                            const discount = variant.effectiveDiscount || 0;
                            const currentPrice = variant.calculatedCurrentPrice;
                    %>
                        <div class="product-card clickable-product-card" data-product-id="<%= product._id %>">
                            <div class="product-image">
                                <img src="<%= product.images && product.images[0] ? product.images[0] : 'https://placehold.co/400' %>" alt="<%= product.name %>">
                                <div class="badge-container">
                                    <% if (discount > 0) { %>
                                        <span class="badge discount">
                                            <%= discount %>% OFF
                                        </span>
                                    <% } %>
                                </div>
                                <% 
                                    const variantIdStr = variant._id.toString(); 
                                    const isInWishlist = typeof userWishlist !== 'undefined' && userWishlist.includes(variantIdStr); 
                                %>
                                <button class="wishlist-btn <%= isInWishlist ? 'liked' : '' %>" type="button" data-variant-id="<%= variant._id %>">
                                    <i class="<%= isInWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                                </button>
                            </div>
                            <div class="product-info">
                                <h3><%= product.name %></h3>
                                <div class="stars">
                                    <% if (pReview && pReview.count > 0) { %>
                                        <% for (let rStar = 1; rStar <= 5; rStar++) { %>
                                            <% if (pReview.avgRating >= rStar) { %>
                                                <i class="fa-solid fa-star active-star"></i>
                                            <% } else if (pReview.avgRating >= rStar - 0.5) { %>
                                                <i class="fa-solid fa-star-half-stroke active-star"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-star empty-star"></i>
                                            <% } %>
                                        <% } %>
                                        <span class="card-review-stat"><%= pReview.avgRating %> (<%= pReview.count %>)</span>
                                    <% } else { %>
                                        <span class="no-card-reviews">No reviews yet</span>
                                    <% } %>
                                </div>
                                <div class="card-footer">
                                    <p class="price">
                                        <% if (discount > 0) { %>
                                            <span class="old-price">₹<%= variant.originalPrice.toLocaleString('en-IN') %></span>
                                        <% } %>
                                        ₹<%= currentPrice.toLocaleString('en-IN') %>
                                    </p>
                                    <button class="add-to-cart-btn" type="button" data-variant-id="<%= variant._id %>">
                                        <i class="fa-solid fa-cart-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    <% }); %>
                <% } else { %>
                    <p class="fallback-notice-text">Check back later for incredible discounts!</p>
                <% } %>
            </div>
        </div>
    </section>

    <section class="categories-section">
        <div class="container">
            <div class="section-header">
                <h2>Shop by Category</h2>
            </div>
            <div class="categories-grid">
                <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                    <% categories.forEach(category => { %>
                        <div class="category-item">
                            <a href="/products?category=<%= category._id %>">
                                <img src="<%= category.image %>" alt="<%= category.name %>">
                                <h3><%= category.name %></h3>
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="fallback-notice-text">Categories currently unavailable.</p>
                <% } %>
            </div>
        </div>
    </section>

    <section class="features">
        <div class="container features-container">
            <div class="feature-item">
                <i class="fa-solid fa-truck-fast"></i>
                <div class="feature-text">
                    <h4>Free Shipping</h4>
                    <p>On orders over ₹500</p>
                </div>
            </div>
            <div class="feature-item">
                <i class="fa-solid fa-shield-halved"></i>
                <div class="feature-text">
                    <h4>Secure Payment</h4>
                    <p>100% secure checkout</p>
                </div>
            </div>
            <div class="feature-item">
                <i class="fa-solid fa-rotate-left"></i>
                <div class="feature-text">
                    <h4>Easy Returns</h4>
                    <p>30-day return policy</p>
                </div>
            </div>
        </div>
    </section>

    <%- include('../partials/user/footer') %>

    <script src="/js/user/home.js"></script>
</body>

</html>