<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/x-icon"
        href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="/css/user/orderpaymentsuccess.css">
</head>

<body>
    <main class="success-wrapper">
        <div class="success-card">
            <div class="brand">HomeStation</div>
            <div class="success-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h1 class="success-title">Thank You!</h1>
            <p class="success-text">Your order has been placed successfully. Order ID: <strong><%= orderId %></strong></p>

            <div class="action-area">
                <a href="/user/orders" class="btn-continue">View Orders</a>
                <a href="/home" class="btn-continue">Continue Shopping</a>
            </div>
        </div>
    </main>
</body>

</html>