<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomeStation - ADMIN</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="/css/admin/404error.css">
</head>

<body>
    <input type="hidden" id="adminCsrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <div class="dashboard-layout">

        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <h2 class="brand-title">HomeStation</h2>
                <button class="close-sidebar" id="closeSidebar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <a href="/admin/dashboard" class="nav-link">
                            <i class="fa-solid fa-chart-pie nav-icon"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/products" class="nav-link">
                            <i class="fa-solid fa-box nav-icon"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/categories" class="nav-link">
                            <i class="fa-solid fa-tags nav-icon"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/orders" class="nav-link">
                            <i class="fa-solid fa-cart-shopping nav-icon"></i> Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/users" class="nav-link">
                            <i class="fa-solid fa-users nav-icon"></i> User Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/sales-report" class="nav-link">
                            <i class="fa-solid fa-file-invoice-dollar nav-icon"></i> Sales Report
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/coupons" class="nav-link">
                            <i class="fa-solid fa-ticket nav-icon"></i> Manage Coupons
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/enquiries" class="nav-link">
                            <i class="fa-solid fa-envelope nav-icon"></i> Enquiry
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/offers" class="nav-link">
                            <i class="fa-solid fa-gift nav-icon"></i> Offers
                        </a>
                    </li>
                </ul>

                <ul class="nav-list logout-section">
                    <li class="nav-item">
                        <form id="adminLogoutForm">
                            <button type="submit" class="nav-link logout-link logout-btn-reset">
                                <i class="fa-solid fa-right-from-bracket nav-icon"></i> Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>
        </aside>

        <div class="main-panel">

            <header class="top-header">
                <div class="header-left">
                    <button class="hamburger-menu" id="hamburgerMenu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
                <div class="header-right">
                    <div class="datetime-display" id="datetimeDisplay"></div>
                    <div class="admin-badge">
                        <i class="fa-solid fa-user-shield"></i> Admin
                    </div>
                </div>
            </header>

            <main class="content-wrapper error-wrapper">
                <div class="error-container">
                    <h1 class="error-code">404</h1>
                    <h2 class="error-title">Page Not Found</h2>
                    <p class="error-desc">Oops! The admin page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
                    <a href="/admin/dashboard" class="btn btn-primary btn-back-dashboard">
                        <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/admin/404error.js"></script>
</body>

</html>