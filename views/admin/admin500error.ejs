<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle : 'HomeStation - Admin Server Error' %>
    </title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
        rel="stylesheet">
    <link rel="icon" type="image/x-icon"
        href="https://res.cloudinary.com/dz7fuqwnr/image/upload/v1778395481/WhatsApp_Image_2026-05-10_at_12.12.36_nra5vk.jpg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin/admin404error.css">
</head>

<body>
    <input type="hidden" id="adminCsrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <div class="dashboard-layout">
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <h2 class="brand-title">HomeStation</h2>
                <button class="close-sidebar" id="closeSidebar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <nav class="sidebar-nav">

            </nav>
        </aside>

        <div class="main-panel">
            <header class="top-header">
                <div class="header-left">
                    <button class="hamburger-menu" id="hamburgerMenu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
                <div class="header-right">
                    <div class="datetime-display" id="datetimeDisplay"></div>
                    <div class="admin-badge">
                        <i class="fa-solid fa-user-shield"></i> Admin
                    </div>
                </div>
            </header>

            <main class="content-wrapper error-wrapper">
                <div class="error-container">
                    <h1 class="error-code">500</h1>
                    <h2 class="error-title">Internal Server Error</h2>
                    <p class="error-desc">
                        <%= typeof message !=='undefined' ? message
                            : 'An unexpected server exception occurred while processing your request.' %>
                    </p>
                    <% if (typeof user !=='undefined' && user) { %>
                        <a href="/admin/dashboard" class="btn btn-primary btn-back-dashboard">
                            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                        </a>
                        <% } else { %>
                            <a href="/admin/login" class="btn btn-primary btn-back-dashboard">
                                <i class="fa-solid fa-right-to-bracket"></i> Return to Login Page
                            </a>
                            <% } %>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/admin/admin404error.js"></script>
</body>

</html>